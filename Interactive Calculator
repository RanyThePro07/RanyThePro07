class RegualarPolygon {
public:
    static void execute() {
        int choice;

        int perimeter;
        int apothem;
        int s; // Side Length
        int n; // Number of Sides

        cout << "Choice the formula you want to solve: " << endl;
        cin >> choice;

        switch (choice) {
            case 1:
                cout << "Enter the Side Length: " << endl;
                cin >> s;

                cout << "Enter the Number of Sides: " << endl;
                cin >> n;

                cout << "Perimeter: " << n * s << endl;
                break;

            case 2:
                cout << "Enter the Number of Sides: " << endl;
                cin >> n;

                cout << "Interior Angle: " << ((n-2) * 180.0) / n << endl;
                break;

            case 3:
                cout << "Enter the Number of Sides: " << endl;
                cin >> n;

                cout << "Exterior Angle: " << 360.0 / n;
                break;

            case 4:
                cout << "Sum of Interior Angle\n" << endl;
                cout << "Enter the Number of Sides: " << endl;
                cin >> n;

                cout << "Answer: " << (n-2) * 180.0;
                break;

            case 5:
                cout << "Number of Diagonals\n" << endl;
                cout << "Enter the Number of Sides: " << endl;
                cin >> n;

                cout << "Answer: " << n*(n-3) / 2;
                break;

            case 6:
                cout << "Apothem\n" << endl;
                cout << "Enter the Side Length (s): " << endl;
                cin >> s;

                cout << "Enter the Number of Sides (n): "<< endl;
                cin >> n;

                cout << "Answer: " << s / (2*tan(M_PI*n));
                break;

            case 7:
                cout << "Circumradius\n" << endl;
                cout << "Enter the Side Length: " << endl;
                cin >> s;

                cout << "Enter the Number of Sides" << endl;
                cin >> n;

                cout << "Answer: " << s / (2*sin(M_PI*n));
                break;

            case 8: // Work on this !!!
                cout << "Area (A)\n" << endl;
                cout << "Enter the Perimeter: " << endl;
                cin >> perimeter;

                cout << "Enter the Apothem: " << endl;
                cin >> apothem;

                cout << "Answer: " << 1.0/2.0 * (perimeter * apothem);
            default:
                break;

        }
    }
};

class Circle {
public:
    static void execute() {
        int choice;

        int radius;
        int circumference;

        cout << "Choice the formula you want to solve: " << endl;
        cin >> choice;

        switch (choice){

            case 1:
                cout << "Enter the Circumference: " << endl;
                cin >> circumference;

                cout << "Radius: " << circumference / (2 * M_PI);
                break;

            case 2:
                cout << "Enter the radius: " << endl;
                cin >> radius;

                cout << "Area: " << M_PI * pow(radius, 2);
                break;

            case 3:
                cout << "Enter the radius: " << endl;
                cin >> radius;

                cout << "Diameter: " << 2 * radius;
                break;

            case 4:
                cout << "Enter the radius: " << endl;
                cin >> radius;

                cout << "Circumference: " << 2 * M_PI * radius;
            default:
                break;
        }
    }
};

class Cone {
public:
    static void execute() {
        int choice;

        int radius;
        int height;
        int volume;

        cout << "1. Height" << "\n";
        cout << "2. Radius" << "\n";
        cout << "3. Volume" << "\n";
        cout << "4. Slant height" << "\n";
        cout << "5. Surface Area" << "\n";
        cout << "6. Lateral Surface" << "\n";
        cout << "7. Base Area" << "\n";

        cout << "\nChoice the formula you want to solve: ";
        cin >> choice;

        if (choice != 8) {
           switch (choice) {
                case 1: // Height
                    cout << "Enter the Height: " << endl;
                    cin >> height;

                    cout << "Enter the Volume: " << endl;
                    cin >> volume;

                    cout << "Radius: " << sqrt(3*(volume/(M_PI*height)));
                    break;

                case 2: // Radius
                    cout << "Enter the Radius: " << endl;
                    cin >> radius;

                    cout << "Enter the Volume: " << endl;
                    cin >> volume;

                    cout << "Height: " << 3 * (volume/(M_PI*pow(radius, 2)));
                    break;

                case 3: // Volume
                    cout << "Enter the Radius: " << endl;
                    cin >> radius;

                    cout << "Enter the Height: " << endl;
                    cin >> height;

                    cout << "Volume: " << M_PI*pow(radius,2)*height/3;
                    break;

                case 4: // Slant height
                    cout << "Enter the radius: " << endl;
                    cin >> radius;

                    cout << "Enter the height: " << endl;
                    cin >> height;

                    cout << "Slant height: " << sqrt(pow(radius,2) + pow(height, 2));
                    break;

                case 5: // Surface Area
                    cout << "Enter the radius: " << endl;
                    cin >> radius;

                    cout << "Enter the height: " << endl;
                    cin >> height;

                    cout << "Surface Area: " << M_PI * radius * (radius + sqrt(pow(height, 2) + pow(radius, 2)));
                    break;

                case 6: // Lateral Surface
                    cout << "Enter the radius: " << endl;
                    cin >> radius;

                    cout << "Enter the height: " << endl;
                    cin >> height;

                    cout << "Lateral Surface: " << M_PI * radius * sqrt(pow(height, 2) + pow(radius, 2));
                    break;

                case 7: // Base Area
                    cout << "Enter the radius: " << endl;
                    cin >> radius;

                    cout << "Base Area: " << M_PI * pow(radius, 2);
                default:
                    break;

            }
        }else{
             cout << "Try again!!!";
        }
    }
};

